generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TeamMember[]

  @@index([email])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  color       String       @default("#10b981")
  /// Guía de story points (markdown). La IA la usa al estimar tickets y como referencia del equipo.
  storyPointGuide String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]
  projects    Project[]
  messages    Message[]
  knowledge   KnowledgeEntry[]
  reports     DailyReport[]
  tickets     Ticket[]
  targetedTickets Ticket[] @relation("TicketTargetTeam")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  defaultProjectId String?
  name      String
  role      String   @default("Developer")
  email     String?
  avatar    String?
  status    String   @default("active") // active, away, offline
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  defaultProject Project? @relation("MemberDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)
  standups  StandupCheckin[]
  projectAssignments ProjectAssignment[]
  assignedTickets Ticket[] @relation("TicketAssignee")
  reportedTickets Ticket[] @relation("TicketReporter")
  privateChatMessages Message[]

  @@index([teamId])
  @@index([userId])
  @@index([defaultProjectId])
}

model Project {
  id              String   @id @default(cuid())
  teamId          String
  name            String
  description     String?
  status          String   @default("active") // active, paused, completed
  jiraProjectKey  String?
  jiraBaseUrl     String?
  jiraToken       String?
  githubRepo      String?
  githubToken     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workflows       TicketWorkflow[]
  tickets         Ticket[]
  defaultForMembers TeamMember[] @relation("MemberDefaultProject")
  memberAssignments ProjectAssignment[]
  chatMessages    Message[]

  @@index([teamId])
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  createdAt DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
}

model TicketWorkflow {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int      @default(0)
  color     String   @default("#10b981")
  isDone    Boolean  @default(false)
  isQa      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  fromTransitions TicketTransition[] @relation("TransitionFromStatus")
  toTransitions   TicketTransition[] @relation("TransitionToStatus")

  @@index([projectId, position])
}

model Ticket {
  id                String   @id @default(cuid())
  teamId            String
  targetTeamId      String?
  projectId         String
  statusId          String
  title             String
  description       String?
  priority          String   @default("medium")
  estimate          String?
  progress          String?
  order             Int      @default(0)
  externalRefs      String?
  metadata          String?
  assigneeMemberId  String?
  reporterMemberId  String?
  /// member | ai | system — quién abrió el ticket (complementa reporterMemberId cuando el origen es IA/sistema)
  createdByType     String   @default("member")
  createdByName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  targetTeam Team?          @relation("TicketTargetTeam", fields: [targetTeamId], references: [id], onDelete: SetNull)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    TicketWorkflow  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee  TeamMember?     @relation("TicketAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  reporter  TeamMember?     @relation("TicketReporter", fields: [reporterMemberId], references: [id], onDelete: SetNull)
  messages  TicketMessage[]
  transitions TicketTransition[]

  @@index([projectId, statusId, order])
  @@index([teamId, createdAt])
  @@index([targetTeamId])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?
  senderName String
  senderType String   @default("member") // member, ai, system
  content    String
  metadata   String?
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketTransition {
  id           String   @id @default(cuid())
  ticketId     String
  fromStatusId String?
  toStatusId   String
  reason       String?
  actorType    String   @default("user") // user, ai, system
  actorName    String?
  createdAt    DateTime @default(now())

  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus   TicketWorkflow? @relation("TransitionFromStatus", fields: [fromStatusId], references: [id], onDelete: SetNull)
  toStatus     TicketWorkflow  @relation("TransitionToStatus", fields: [toStatusId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([toStatusId])
}

model Message {
  id              String   @id @default(cuid())
  teamId          String
  /// Miembro del equipo dueño de este hilo (chat privado 1:1 con la IA); todas las líneas del hilo comparten el mismo owner.
  ownerMemberId   String
  /// Hilo distinto por proyecto: mismo miembro, distintos `projectId` → historiales separados.
  projectId       String
  senderId        String? // null for AI
  senderName      String
  senderType      String  @default("member") // member, ai, system
  content         String
  metadata        String? // JSON string for additional context
  createdAt       DateTime @default(now())

  team    Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner   TeamMember @relation(fields: [ownerMemberId], references: [id], onDelete: Cascade)
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([ownerMemberId])
  @@index([projectId])
  @@index([teamId, ownerMemberId, projectId])
  @@index([createdAt])
}

model KnowledgeEntry {
  id         String   @id @default(cuid())
  teamId     String
  key        String
  value      String
  source     String?  // who provided this info
  category   String   @default("general") // general, technical, process, blocker, decision
  confidence Int      @default(80) // 0-100
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([category])
}

model DailyReport {
  id        String   @id @default(cuid())
  teamId    String
  date      String   // YYYY-MM-DD format
  summary   String   // markdown content
  status    String   @default("draft") // draft, published
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, date])
  @@index([teamId])
}

model StandupCheckin {
  id            String   @id @default(cuid())
  memberId      String
  date          String   // YYYY-MM-DD format
  yesterdayWork String?
  todayPlan     String?
  blockers      String?
  mood          String   @default("neutral") // great, good, neutral, stressed, blocked
  createdAt     DateTime @default(now())

  member        TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([memberId])
}

model IntegrationLog {
  id        String   @id @default(cuid())
  teamId    String
  type      String   // jira, github
  action    String   // ticket_created, status_changed, comment_added, etc.
  externalId String? // Jira issue key or GitHub issue number
  data      String?  // JSON string with full response data
  status    String   @default("success") // success, error
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([type])
}
